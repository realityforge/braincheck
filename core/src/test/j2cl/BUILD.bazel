load("@j2cl//build_defs:rules.bzl", "J2CL_OPTIMIZED_DEFS")
load("@rules_closure//closure:defs.bzl", "closure_js_binary", "closure_js_library")

package(default_visibility = ["//visibility:private"])

closure_js_library(
    name = "entry_point",
    srcs = ["entry_point.js"],
    deps = ["//:core-j2cl"],
)

closure_js_binary(
    name = "braincheck_j2cl_smoke",
    defs = J2CL_OPTIMIZED_DEFS + [
        "--entry_point=goog:braincheck.j2cl.BuildTest",
        "--define=jre.checks.checkLevel=NORMAL",
        "--define=jre.logging.logLevel=OFF",
        "--define=jre.classMetadata=STRIPPED",
        "--rewrite_polyfills=false",
    ],
    deps = [":entry_point"],
)
