load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

WARNINGS = [
    "+unsorted-dict-items",
    "-module-docstring",
    "-function-docstring",
]

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "fix",
    lint_warnings = WARNINGS,
)

buildifier(
    name = "buildifier_check",
    diff_command = "diff -u",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "warn",
    lint_warnings = WARNINGS,
    mode = "diff",
)

filegroup(
    name = "artifacts",
    srcs = [
        "//core/src/main/java/org/realityforge/braincheck:core",
        "//jre/src/main/super/org/realityforge/braincheck/super/java/util:jre_sources",
        "//testng/src/main/java/org/realityforge/braincheck:testng",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        "//core/src/test/java/org/realityforge/braincheck:all_tests",
        "//testng/src/test/java/org/realityforge/braincheck:all_tests",
        "//tools/release:all_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core/src/test/java/org/realityforge/braincheck/gwt:smoke",
        "//tools/release/org/realityforge/braincheck/release:javadoc_jar_builder",
    ],
)
